# Copy to db/.env and set real values. Never commit db/.env.
POSTGRES_USER=paper_compass
POSTGRES_PASSWORD=change_me
POSTGRES_DB=paper_compass
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_min_8_chars
# Host ports. Change them if something else already owns a port (a local PostgreSQL service often owns 5432).
POSTGRES_PORT=5432
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
